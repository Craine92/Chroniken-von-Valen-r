{
  "name": "chroniken-von-valenor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev --workspace @valenor/server\" \"npm run dev --workspace @valenor/client\"",
    "build": "npm run build --workspace @valenor/client && npm run build --workspace @valenor/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspace @valenor/server",
    "dist:win": "npm run anleitung:pdf && electron-builder --win portable nsis --x64 --publish never",
    "anleitung:pdf": "electron scripts/anleitung-pdf.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "de.valenor.chroniken",
    "productName": "Chroniken von Valenør",
    "copyright": "© 2026 Chroniken von Valenør",
    "asar": true,
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/build/icon.png",
      "apps/client/dist/**/*",
      "!apps/client/dist/assets/buildings/building-test-sheet.png",
      "!apps/client/dist/assets/characters/characters-sheet.png",
      "apps/server/dist/**/*",
      "apps/server/package.json",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "desktop/Anleitung.pdf",
        "to": "Anleitung.pdf"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Chroniken von Valenør",
      "uninstallDisplayName": "Chroniken von Valenør",
      "installerIcon": "desktop/build/icon.ico",
      "uninstallerIcon": "desktop/build/icon.ico",
      "installerHeaderIcon": "desktop/build/icon.ico",
      "include": "desktop/build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Chroniken-von-Valenor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Chroniken-von-Valenor-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "description": "Fantasy-Brettspiel für TV und Handys im selben WLAN.",
  "author": "Chroniken von Valenør"
}
